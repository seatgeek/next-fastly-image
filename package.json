{
  "name": "@seatgeek/next-fastly-image",
  "version": "0.1.0",
  "description": "Stateless, zero-dependency Fastly Image Optimizer loader for next/image — typed, host-agnostic, and tested.",
  "keywords": [
    "next",
    "nextjs",
    "next/image",
    "image",
    "loader",
    "fastly",
    "image-optimizer",
    "cdn",
    "srcset"
  ],
  "license": "Apache-2.0",
  "author": "SeatGeek",
  "homepage": "https://github.com/seatgeek/next-fastly-image#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seatgeek/next-fastly-image.git"
  },
  "bugs": {
    "url": "https://github.com/seatgeek/next-fastly-image/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.9",
  "typesVersions": {
    "*": {
      "next": [
        "./dist/next.d.ts"
      ],
      "component": [
        "./dist/component.d.ts"
      ]
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./next": {
      "import": {
        "types": "./dist/next.d.ts",
        "default": "./dist/next.js"
      },
      "require": {
        "types": "./dist/next.d.cts",
        "default": "./dist/next.cjs"
      }
    },
    "./component": {
      "import": {
        "types": "./dist/component.d.ts",
        "default": "./dist/component.js"
      },
      "require": {
        "types": "./dist/component.d.cts",
        "default": "./dist/component.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "next": ">=13",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check:exports": "publint && attw --pack .",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@biomejs/biome": "^2.2.0",
    "@changesets/cli": "^2.29.5",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^3.2.4",
    "next": "^16.3.1",
    "publint": "^0.3.12",
    "react": "^19.1.1",
    "react-dom": "^19",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
